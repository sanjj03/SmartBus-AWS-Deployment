# Copy this file to ".env" and fill in your real values.
# On EC2 you can also just set these as real environment variables instead of using a file.

# --- RDS (MySQL) ---
DB_HOST=your-rds-endpoint.xxxxxxxxxx.ap-south-1.rds.amazonaws.com
DB_USER=admin
DB_PASSWORD=your-master-password
DB_NAME=smartbus

# --- S3 (used for backups from the Admin panel) ---
S3_BUCKET=smartbus-tracker-yourname
AWS_REGION=ap-south-1

# --- Flask ---
FLASK_DEBUG=False
